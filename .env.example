# Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# โซนเป้าหมาย: 1=กทม+ปริมณฑล  2=+EEC  3=+หัวเมืองภาค
TARGET_TIER=1

# ระบุจังหวัดเองเพื่อ override tier (เว้นว่างไว้ถ้าใช้ tier)
TARGET_PROVINCES=

LOG_LEVEL=INFO
